{
	"appId": "com.amarmess.app",
	"appName": "Amar Mess",
	"webDir": "dist",
	"server": {
		"url": "https://mymessmanagement.onrender.com",
		"cleartext": false,
		"androidScheme": "https",
		"iosScheme": "https",
		"allowNavigation": [
			"mymessmanagement.onrender.com",
			"*.firebaseapp.com",
			"*.firebase.com",
			"accounts.google.com",
			"*.google.com",
			"*.googleapis.com",
			"apis.google.com"
		]
	},
	"plugins": {
		"SplashScreen": {
			"launchShowDuration": 1800,
			"launchAutoHide": true,
			"backgroundColor": "#020617",
			"showSpinner": true,
			"spinnerColor": "#06b6d4",
			"androidSplashResourceName": "splash",
			"androidScaleType": "CENTER_CROP",
			"splashFullScreen": true,
			"splashImmersive": true
		},
		"StatusBar": {
			"style": "DARK",
			"backgroundColor": "#020617"
		}
	}
}

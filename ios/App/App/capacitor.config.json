{
	"appId": "com.amarmess.app",
	"appName": "Amar Mess",
	"webDir": "dist",
	"server": {
		"url": "https://mymessmanagement.onrender.com",
		"cleartext": false,
		"androidScheme": "https",
		"iosScheme": "https"
	},
	"plugins": {
		"SplashScreen": {
			"launchShowDuration": 1800,
			"launchAutoHide": true,
			"backgroundColor": "#020617",
			"showSpinner": true,
			"spinnerColor": "#06b6d4",
			"androidSplashResourceName": "splash",
			"androidScaleType": "CENTER_CROP",
			"splashFullScreen": true,
			"splashImmersive": true
		},
		"StatusBar": {
			"style": "DARK",
			"backgroundColor": "#020617"
		}
	},
	"packageClassList": [
		"SplashScreenPlugin",
		"StatusBarPlugin"
	]
}
